<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= movie.title_ru %> - Детали</title>
    <link rel="stylesheet" href="/movie.css">
</head>
<body>
    <h1><%= movie.title_ru %></h1>
    <h2 class="original-title"><%= movie.title_or %></h2>
    
    <div class="main_info">
        <div class="info">
            <p><strong>Год:</strong> <%= new Date(movie.launch).getFullYear() %></p>
            <p><strong>Длительность:</strong> <%= movie.duration %> минут</p>
            
            <% if (movie.marksAmount > 0) { %>
                <p><strong>Средняя оценка:</strong> <%= movie.marksAmount > 0 ? (movie.marksScore / movie.marksAmount).toFixed(2) : '-' %></p>
                <p><strong>Количество оценок:</strong> <%= movie.marksAmount > 0 ? movie.marksAmount : '-' %></p>
            <% } else { %>
                <p><strong>Нет оценок</strong></ul>
            <% } %>
        </div>
        <h2>Описание</h2>
    </div>
    
    <div class="genres_and_countries">
        <div class = "genres">
            <h2>Жанры</h2>
            <li>
                <% if (movie.genres.length > 0) { %>
                    <% movie.genres.forEach(genre => { %>
                        <ul class="genre-item"><%= genre.genre.value %></ul>
                    <% }) %>
                <% } else { %>
                    <ul class="genre-item">Нет жанров</ul>
                <% } %>
            </li>
        </div>

        <div class = "genres">
            <h2>Страны</h2>
            <li>
                <% if (movie.countries.length > 0) { %>
                    <% movie.countries.forEach(movieCountry => { %>
                        <ul class="country-item"><%= movieCountry.country.value %></ul>
                    <% }) %>
                <% } else { %>
                    <ul class="country-item">Нет стран</ul>
                <% } %>
            </li>
        </div>
    </div>

    <div class="rating-form">
        <h2>Ваша оценка</h2>
        <% if (movie.marks.length > 0) { %>
            <p>Ваша оценка: <strong><%= movie.marks[0].value %></strong></p>
            <p>Время оценки: <strong><%= new Date(movie.marks[0].assignedAt).toLocaleString('ru-RU', { hour: 'numeric', minute: 'numeric', day: 'numeric', month: 'numeric', year: 'numeric' }) %></strong></p>
            <form action="/fr7/movies/<%= movie.id %>/rate" method="POST">
                <label for="newMark">Изменить оценку:</label>
                <input type="number" name="value" id="newMark" min="1" max="100" value="<%= movie.marks[0].value %>" required>
                <button type="submit">Обновить</button>
            </form>
        <% } else { %>
            <form action="/fr7/movies/<%= movie.id %>/rate" method="POST">
                <label for="newMark">Оцените фильм:</label>
                <input type="number" name="value" id="newMark" min="1" max="100" required>
                <button type="submit">Оценить</button>
            </form>
        <% } %>
    </div>

    <a href="/fr7/movies">Назад к списку фильмов</a>
</body>
</html>
