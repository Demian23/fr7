<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Список фильмов</title>
    <link rel="stylesheet" href="/movies.css">
</head>
<body>
    <h1>Список фильмов</h1>
    <table>
        <thead>
            <tr>
                <th>Название</th>
                <th>Оригинальное название</th>
                <th>Год выпуска</th>
                <th>Средняя оценка</th>
            </tr>
        </thead>
        <tbody>
            <% movies.forEach(movie => { %>
                <tr onclick="location.href='/fr7/movies/<%= movie.id %>'" style="cursor: pointer;">
                    <td>
                        <%= movie.title_ru %>
                        <div class="genres">
                            <% if (movie.genres.length > 0) { %>
                                <%= movie.genres.map(genre => 
                                    genre.genre.value).join(', ') %>
                            <% } else { %>
                                Нет жанров
                            <% } %>
                        </div>    
                    </td>
                    <td class="original-title"><%= movie.title_or %></td>
                    <td><%= new Date(movie.launch).getFullYear() %></td>
                    <td>
                        <span class="average-mark" title="<%= movie.marksAmount > 0 ? movie.marksScore + ' / ' + movie.marksAmount : '-' %>">
                            <%= movie.marksAmount > 0 ? (movie.marksScore / movie.marksAmount).toFixed(2) : '-' %>
                        </span>
                    </td>
                </tr>
            <% }) %>
        </tbody>    
    </table>
</body>
</html>
