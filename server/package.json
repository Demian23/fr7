{
    "name": "server",
    "version": "0.0.1",
    "main": "src/server.ts",
    "license": "MIT",
    "scripts": {
        "dev": "tsnd --respawn --transpile-only --exit-child --env-file=.env src/server.ts",
        "debug": "tsnd --inspect=52345 --files --respawn --transpile-only --env-file=.env src/server.ts",
        "db:push": "npx prisma db push",
        "db:gen": "npx prisma generate --schema=./src/prisma/schema.prisma",
        "db:mig": "npx prisma migrate dev --schema=./src/prisma/schema.prisma --name ",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format:fix": "prettier --write .",
        "format:check": "prettier . --check"
    },
    "dependencies": {
        "@prisma/client": "^5.21.1",
        "cookie-parser": "^1.4.7",
        "express": "^4.21.1",
        "jsonwebtoken": "^9.0.2",
        "socket.io": "^4.8.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.14.0",
        "@types/cookie-parser": "^1.4.8",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^22.8.6",
        "@types/socket.io": "^3.0.2",
        "cors": "^2.8.5",
        "eslint": "^9.14.0",
        "globals": "^15.11.0",
        "prettier": "^3.3.3",
        "prisma": "^5.21.1",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.12.2"
    }
}
