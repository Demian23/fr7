{
    "name": "server",
    "version": "0.0.1",
    "main": "src/server.ts",
    "license": "MIT",
    "scripts": {
        "dev": "tsnd --respawn --transpile-only --exit-child --env-file=.env src/server.ts",
        "db:push": "npx prisma db push",
        "db:gen": "npx prisma generate --schema=./src/prisma/schema.prisma",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format:fix": "prettier --write .",
        "format:check": "prettier . --check"
    },
    "dependencies": {
        "@prisma/client": "^5.21.1",
        "express": "^4.21.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.14.0",
        "@types/express": "^5.0.0",
        "@types/node": "^22.8.6",
        "eslint": "^9.14.0",
        "globals": "^15.11.0",
        "prettier": "^3.3.3",
        "prisma": "^5.21.1",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.12.2"
    }
}
